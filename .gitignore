# ============================================================
# AI 短剧工作台 · .gitignore
# 原则：代码与规范进版本库；生成物、大文件、密钥不进。
# ============================================================

# ---------- 密钥与凭证（最重要）----------
# 签名 URL 含 q-ak 访问密钥，绝不入库
urls.local.json
*.local.json
.env
.env.*
*.key
*.pem
secrets/
credentials*

# ---------- 演示与素材产物（体积大 / 可重建）----------
演示输出/
**/风格对照/**
06_资产/
05_成片/
10_首尾帧/

# 保留目录占位
!06_资产/.gitkeep
!05_成片/.gitkeep
!10_首尾帧/.gitkeep

# ---------- 日志与临时 ----------
_*.txt
_*.log
_*.out
pipeline/_run.log
pipeline/_run.out
pipeline/_push.txt
pipeline/_v.txt
pipeline/_sc.txt
_prompt_preview.txt
probe2.out
.git-commit-msg.txt
*.tmp
*.bak
*.log
tmp/
temp/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- 模型权重 ----------
*.safetensors
*.ckpt
*.pt
*.onnx
